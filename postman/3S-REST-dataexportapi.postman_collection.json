    {
      "name": "05 - Erros e limites",
      "item": [
        {
          "name": "5.1 - idVeiculo inexistente (negativo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ListaUltimaPosicaoVeiculos/999999999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ListaUltimaPosicaoVeiculos",
                "999999999"
              ]
            },
            "description": "Documenta se devolve 3S.xxxx, 404, ou lista vazia."
          }
        },
        {
          "name": "5.2 - Sem token (negativo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/ListaVeiculos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ListaVeiculos"
              ]
            },
            "description": "Confirma que a rota exige Bearer mesmo sem estar marcada explicitamente no swagger.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "5.3 - Burst rate limit (rode via Collection Runner, delay 0)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ValidaLogin",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ValidaLogin"
              ]
            },
            "description": "Duplique esta request 12x numa pasta e rode com Collection Runner, delay 0, para descobrir o rate limit real desta API (o SOAP antigo documentava 10/min, mas isso NAO esta confirmado aqui).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuario}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ===================================================================",
          "// Guard compartilhado - roda em TODA request da collection.",
          "//",
          "// CONFIRMADO por teste real em 04/08/2026 (nao e o que o swagger sugere):",
          "// erro vem como TEXTO PURO \"3S.xxxx - mensagem\", Content-Type text/plain,",
          "// independente do que o swagger.json documenta como schema de erro",
          "// (ErroProcessamento em JSON). Exemplo real capturado:",
          "//   HTTP 400, Content-Type: text/plain; charset=utf-8",
          "//   corpo: \"3S.1041 - Usuario sem permissao de acesso ao webservice.\"",
          "//",
          "// Sucesso TAMBEM pode vir com Content-Type text/plain mesmo quando o",
          "// corpo e JSON de verdade (o swagger declara text/plain nos 200 de",
          "// varios endpoints) - por isso o guard tenta JSON.parse sempre, e nao",
          "// confia no header Content-Type para decidir o formato.",
          "// ===================================================================",
          "const raw = pm.response.text();",
          "const status = pm.response.code;",
          "",
          "let parsed = null;",
          "try { parsed = JSON.parse(raw); } catch (e) { /* nao e JSON, ok */ }",
          "",
          "const ehNegativo = pm.info.requestName.toLowerCase().includes(\"negativo\");",
          "const matchErro = raw.match(/3S\\.\\d{3,5}\\s*-\\s*.+/);",
          "",
          "if (ehNegativo) {",
          "    pm.test(\"Retornou erro 3S.xxxx como esperado\",",
          "        () => pm.expect(matchErro, \"esperava um erro 3S.xxxx no corpo\").to.not.be.null);",
