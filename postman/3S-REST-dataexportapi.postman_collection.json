          "    if (matchErro) console.log(\">>> ATENCAO erro inesperado: \" + matchErro[0].trim());",
          "}",
          "",
          "console.log(\">>> Content-Type real:\", pm.response.headers.get(\"Content-Type\"));",
          "console.log(\">>> Corpo e JSON valido?\", parsed !== null);",
          "",
          "pm.collectionVariables.set(\"last_raw\", raw.slice(0, 3000));",
          "pm.collectionVariables.set(\"last_is_json\", parsed !== null ? \"true\" : \"false\");"
        ]
      }
