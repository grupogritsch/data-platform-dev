# =============================================================================
# Data Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (porta 5433)
# -----------------------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=dw

# -----------------------------------------------------------------------------
# pgAdmin (http://localhost:5050)
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin123

# -----------------------------------------------------------------------------
# N8N (http://localhost:5678)
# Usa o mesmo PostgreSQL acima como banco de dados (database: n8n)
# -----------------------------------------------------------------------------
N8N_USER=admin
N8N_PASSWORD=admin123

# -----------------------------------------------------------------------------
# Timezone
# Referência: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# -----------------------------------------------------------------------------
TIMEZONE=America/Sao_Paulo

# -----------------------------------------------------------------------------
# 3S Tecnologia — webservice SOAP data_export
# Usado pelos workflows "3S - *" via $env.TRES_S_USUARIO / $env.TRES_S_SENHA
# nos nodes Code. Solicite a liberação de acesso ao webservice com a 3S
# antes de usar (ver documentacao/ManualConsumoWebService3S_080125.pdf, §2.3).
# -----------------------------------------------------------------------------
TRES_S_USUARIO=troque_pelo_usuario_liberado
TRES_S_SENHA=troque_pela_senha

# -----------------------------------------------------------------------------
# Fechamento de fatura TruckPag (truckpag-fechamento-fatura/)
# SQLSERVER_* = ERP Bluefleet (SQL Server) -- guardrail: nunca automatizar
# lancamento de fatura la, so leitura. DW_* aponta pro mesmo Postgres acima
# (nomes diferentes porque o sub-projeto foi trazido de outro repo em
# 27/08/2026); API_TRUCKPAG_* = API nova da TruckPag (ainda pouco consumida).
# -----------------------------------------------------------------------------
SQLSERVER_HOST=
SQLSERVER_PORT=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_DB=
DW_HOST=
DW_PORT=
DW_NAME=
DW_USER=
DW_PASSWORD=
API_TRUCKPAG_PRD=
API_TRUCKPAG_HML=
