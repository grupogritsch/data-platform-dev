    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT \n    h.IdItemOrdemServico AS id_item_os,\n    h.IdNF AS id_nf,\n    h.NumeroNF AS numero_nf,\n    h.OrdemServico AS ordem_servico,\n    h.Ocorrencia AS ocorrencia,\n    h.Placa AS placa,\n    h.DescricaoItem AS descricao_item,\n    h.TipoItem AS tipo_item,\n    h.Tipo AS tipo,\n    h.DescricaoCompleta AS descricao_completa,\n    h.Quantidade AS quantidade,\n    h.ValorUnitario AS valor_unitario,\n    h.ValorTotal AS valor_total,\n    h.UnidadeDeFaturamento AS unidade_de_faturamento,\n    h.FilialOperacional AS filial_operacional,\n    h.SituacaoVeiculo AS situacao_veiculo,\n    h.DataCriacaoOcorrencia AS data_criacao_ocorrencia,\n    h.DataEmissao AS data_emissao,\n    h.DataCriacao AS data_criacao,\n    h.UnidadeDeFaturamentoContrato AS unidade_de_faturamento_contrato,\n    h.MovFilialDestino AS mov_filial_destino,\n    h.DataVenda AS data_venda,\n    h.FilialOperacionalOcorrencia AS filial_operacional_ocorrencia,\n    h.FILIAL AS filial,\n    h.Natureza_Correta AS natureza_correta,\n    h.CriadoPor AS criado_por,\n    om.Fornecedor AS fornecedor,\n    om.OdometroAtual AS odometro_atual\nFROM dbo.vw_RelatorioFKM_Historico h\nLEFT JOIN dbo.OcorrenciasManutencao om \n  ON om.IdOcorrencia = TRY_CAST(h.Ocorrencia AS BIGINT)\nWHERE h.DataCriacao >= '{{ $json.start_date }}' \n  AND h.DataCriacao < '{{ $json.end_date }}'\nORDER BY h.IdItemOrdemServico\nOFFSET {{ $json.offset }} ROWS\nFETCH NEXT 20000 ROWS ONLY;"
      },
