    {
      "parameters": {
        "jsCode": "const today = new Date();\nconst startDate = new Date();\nstartDate.setDate(startDate.getDate() - 365);\nconst endDate = new Date(today.getTime() + 86400000);\n\nconst sd = startDate.toISOString().split('T')[0];\nconst ed = endDate.toISOString().split('T')[0];\n\nconst staticData = $getWorkflowStaticData('global');\nstaticData.start_date = sd;\nstaticData.end_date = ed;\nstaticData.currentOffset = 0;\n\nreturn [{\n  json: {\n    start_date: sd,\n    end_date: ed,\n    offset: 0\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
