    {
      "parameters": {
        "jsCode": "// Extrai todos os registros do array \"data\" dentro do response\nconst rawItems = $input.all();\nconst items = rawItems.flatMap(item => {\n  const data = item.json.data; // <-- aqui, é sempre \"data\"\n  return data.map(record => ({ json: record }));\n});\n\nconst CHUNK_SIZE = 1000;\nconst controlCols = ['inserido', 'atualizado'];\nconst allCols = Object.keys(items[0].json).filter(c => !controlCols.includes(c));\nconst conflictCol = allCols[0]; // transacao_id\nconst tableName = `truckpag_analitico_transacao`;\n\nconst updateSet = allCols\n  .filter(c => c !== conflictCol)\n  .map(c => `\"${c}\" = EXCLUDED.\"${c}\"`)\n  .join(',\\n  ');\n\n// Deduplica globalmente, mantendo a última ocorrência de cada chave\nconst seen = new Map();\nfor (const item of items) {\n  const key = item.json[conflictCol];\n  seen.set(key, item);\n}\nconst dedupedItems = Array.from(seen.values());\n\nconst chunks = [];\nfor (let i = 0; i < dedupedItems.length; i += CHUNK_SIZE) {\n  chunks.push(dedupedItems.slice(i, i + CHUNK_SIZE));\n}\n\nconst result = [];\nfor (const chunk of chunks) {\n  const values = chunk.map(item => {\n    const vals = allCols.map(col => {\n      const v = item.json[col];\n      if (v === null || v === undefined) return 'NULL';\n      if (typeof v === 'number') return v;\n      if (typeof v === 'boolean') return v ? 'TRUE' : 'FALSE';\n      return `'${String(v).replace(/'/g, \"''\")}'`;\n    });\n    return `(${vals.join(', ')}, NOW(), NULL)`;\n  }).join(',\\n');\n\n  const sql = `\n    INSERT INTO bronze.\"${tableName}\" (\n      ${allCols.map(c => `\"${c}\"`).join(', ')},\n      inserido,\n      atualizado\n    )\n    VALUES ${values}\n    ON CONFLICT (\"${conflictCol}\") DO UPDATE SET\n      ${updateSet},\n      atualizado = NOW();\n  `.trim();\n\n  result.push({ json: { sql } });\n}\n\nreturn result;"
      },
