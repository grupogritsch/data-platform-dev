    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const XLSX = require('xlsx');\n\nfunction addSheet(wb, sheetName, items) {\n  const rows = items.map((item) => item.json);\n  const ws = XLSX.utils.json_to_sheet(rows);\n  XLSX.utils.book_append_sheet(wb, ws, sheetName);\n}\n\nconst wb = XLSX.utils.book_new();\n\naddSheet(wb, 'Resumo', $('Resumo').all());\naddSheet(wb, 'Contabilidade', $('Contabilidade').all());\naddSheet(wb, 'Relatorio', $('Relatorio').all());\naddSheet(wb, 'Rateio Garagem', $('Rateio Garagem').all());\naddSheet(wb, 'Rateio Posto', $('Rateio Posto').all());\n\nconst buffer = XLSX.write(wb, { type: 'buffer', bookType: 'xlsx' });\n\nconst dataVencimento = $('Fatura alvo').first().json.data_vencimento;\nconst fileName = `Fechamento_Fatura_Combustivel_${dataVencimento}.xlsx`;\n\nconst binaryData = await this.helpers.prepareBinaryData(\n  buffer,\n  fileName,\n  'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'\n);\n\nreturn [{ json: { data_vencimento: dataVencimento }, binary: { planilha_fechamento: binaryData } }];\n"
      },
