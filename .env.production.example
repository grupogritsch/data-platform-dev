# =============================================================================
# Data Platform - Ambiente de PRODUÇÃO
# =============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo: cp .env.production.example .env
# 2. Substitua TODOS os valores com credenciais fortes e seguras
# 3. NUNCA commite o arquivo .env no git
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# IMPORTANTE: Use credenciais fortes e únicas para produção
# -----------------------------------------------------------------------------
POSTGRES_USER=seu_usuario_postgres_producao
POSTGRES_PASSWORD=sua_senha_forte_e_segura_aqui
POSTGRES_DB=dataplatform_dw_prod

# -----------------------------------------------------------------------------
# pgAdmin
# IMPORTANTE: Use um email válido e senha forte
# -----------------------------------------------------------------------------
PGADMIN_EMAIL=admin@suaempresa.com
PGADMIN_PASSWORD=senha_forte_pgadmin_producao

# -----------------------------------------------------------------------------
# N8N
# Na primeira vez que acessar, você criará uma conta owner.
# Use email corporativo e senha forte para produção.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Timezone
# Ajuste conforme a localização do seu servidor de produção
# Referência: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# -----------------------------------------------------------------------------
TIMEZONE=America/Sao_Paulo

# =============================================================================
# CHECKLIST DE SEGURANÇA PARA PRODUÇÃO:
# =============================================================================
# [ ] Todas as senhas foram alteradas e são fortes (mínimo 16 caracteres)
# [ ] As senhas são diferentes entre os serviços
# [ ] O email do pgAdmin é válido e acessível
# [ ] As portas dos serviços estão protegidas por firewall
# [ ] Backup automático do PostgreSQL está configurado
# [ ] O arquivo .env está no .gitignore
# [ ] Considere usar secrets management (Docker Secrets, Vault, etc)
# =============================================================================
